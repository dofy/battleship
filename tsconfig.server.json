{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "lib/gameStore.ts",
    "lib/shipUtils.ts",
    "lib/socketHandlers.ts",
    "lib/socketTypes.ts"
  ]
}
